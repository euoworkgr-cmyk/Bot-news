[Unit]
Description=Telegram news bot
After=network-online.target
Wants=network-online.target

[Service]
User=newsbot
Group=newsbot
WorkingDirectory=/opt/newsbot
EnvironmentFile=/etc/newsbot.env
ExecStart=/opt/newsbot/venv/bin/python /opt/newsbot/bot.py
Restart=always
RestartSec=10
MemoryMax=200M

[Install]
WantedBy=multi-user.target
