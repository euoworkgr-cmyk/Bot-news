BOT_TOKEN=
CHAT_ID=
POLZA_API_KEY=
POLZA_MODEL=openai/gpt-6-luna
OPENROUTER_RANKING_MAX_TOKENS=8192
OPENROUTER_PROFILE_MAX_TOKENS=2048

CHECK_INTERVAL=600
DB_PATH=/var/lib/newsbot/news.db
PROFILE_PATH=/var/lib/newsbot/recommendation_profile.json
BOT_TIMEZONE=UTC

DAILY_NEWS_LIMIT=10
AI_BATCH_SIZE=5
AI_BATCH_MAX_ITEMS=10
AI_BATCH_MAX_WAIT=3600
AI_MIN_SCORE=65
# Ranking requests per local day, including failed attempts; profile calls excluded.
# 0 disables the budget. Unevaluated articles remain pending until retry/expiry.
AI_DAILY_REQUEST_LIMIT=10
ARTICLE_MAX_CHARS=12000
CANDIDATE_MAX_AGE_HOURS=24

# Seconds; a frequency ceiling, never a requirement to fill the quota.
MIN_SEND_INTERVAL=5400
SEND_RETRY_SECONDS=300

# Urgent bypass is disabled until trusted feed names are explicitly configured.
# Example: URGENT_TRUSTED_SOURCES=Meduza,Habr
URGENT_TRUSTED_SOURCES=
URGENT_MIN_SCORE=95
URGENT_MAX_AGE_HOURS=3
URGENT_MIN_INTERVAL=1800
URGENT_DAILY_LIMIT=1

# AI_MAX_SEND_PER_BATCH is obsolete and ignored; all worthy items enter the queue.
ALLOWED_VOTERS=
