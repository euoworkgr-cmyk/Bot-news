BOT_TOKEN=
CHAT_ID=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_RANKING_MAX_TOKENS=8192
OPENROUTER_PROFILE_MAX_TOKENS=2048

CHECK_INTERVAL=600
DB_PATH=/var/lib/newsbot/news.db
PROFILE_PATH=/var/lib/newsbot/recommendation_profile.json
BOT_TIMEZONE=UTC

DAILY_NEWS_LIMIT=10
# Local hours (BOT_TIMEZONE) when the bot ranks and posts, e.g. 8-23
ACTIVE_HOURS=0-24
# 1 = spread DAILY_NEWS_LIMIT evenly over ACTIVE_HOURS
PACE_POSTS=1
AI_BATCH_SIZE=5
AI_BATCH_MAX_ITEMS=10
AI_BATCH_MAX_WAIT=3600
AI_MAX_SEND_PER_BATCH=3
AI_MIN_SCORE=65
# Max ranking requests per day (0 = no limit); the daily profile update is always allowed
AI_DAILY_REQUEST_LIMIT=40

ALLOWED_VOTERS=
